; Engine configuration file.
; Godot 4.3+ ile açın (4.4 / 4.5 de sorunsuz çalışır).

config_version=5

[application]

config/name="Son Sığınak"
config/description="İzometrik zombi hayatta kalma prototipi"
config/version="0.7.0"
run/main_scene="res://scenes/main_menu.tscn"
config/icon="res://assets/ui/icon.png"
config/windows_native_icon="res://icon.ico"
boot_splash/show_image=true
boot_splash/image="res://assets/ui/splash.png"
boot_splash/bg_color=Color(0.055, 0.055, 0.06, 1)
boot_splash/fullsize=true
boot_splash/stretch_mode=1
boot_splash/use_filter=true
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

Audio="*res://scripts/audio.gd"
Settings="*res://scripts/settings.gd"
Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="zombies"

[rendering]

anti_aliasing/quality/msaa_3d=2
